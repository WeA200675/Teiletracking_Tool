{
  "Title": "TrackingImportArchiv",
  "Description": "Unveränderte Original-Migrationspakete als Nachweis der importierten Quelldaten",
  "Template": "DocumentLibrary",
  "Fields": [
    {
      "InternalName": "BatchId",
      "DisplayName": "Batch ID",
      "Type": "Text",
      "Required": true
    },
    {
      "InternalName": "DeviceId",
      "DisplayName": "Device ID",
      "Type": "Text",
      "Required": true
    },
    {
      "InternalName": "PackageHash",
      "DisplayName": "Package Hash",
      "Type": "Text",
      "Required": true
    },
    {
      "InternalName": "PackageCreatedAt",
      "DisplayName": "Paket erstellt am",
      "Type": "DateTime",
      "Required": true
    },
    {
      "InternalName": "ImportedAt",
      "DisplayName": "Importiert am",
      "Type": "DateTime",
      "Required": true
    },
    {
      "InternalName": "ImportedBy",
      "DisplayName": "Importiert von",
      "Type": "Text",
      "Required": true
    },
    {
      "InternalName": "AppVersion",
      "DisplayName": "App-Version",
      "Type": "Text",
      "Required": false
    },
    {
      "InternalName": "SchemaVersion",
      "DisplayName": "Schema-Version",
      "Type": "Number",
      "Required": true
    },
    {
      "InternalName": "RecordCount",
      "DisplayName": "Datensätze",
      "Type": "Number",
      "Required": true
    },
    {
      "InternalName": "ImportStatus",
      "DisplayName": "Importstatus",
      "Type": "Choice",
      "Required": true,
      "Choices": [
        "IMPORTED",
        "REJECTED",
        "CONFLICT",
        "ERROR"
      ]
    }
  ]
}
